import pandas as pd
import matplotlib.pyplot as plt
import pylab as plb
plb.rcParams['font.sans-serif'] = ['SimHei']    # 指定默认字体
plb.rcParams['font.serif'] = ['SimHei']
plb.rcParams['axes.unicode_minus'] = False     # 解决保存图像是负号'-'显示为方块的问题
%matplotlib inline


factor_fn_list = ['inc_net_profit_year_on_year_zscore', 'btop_zscore', 'roe_zscore', 'size_zscore','net_profit_margin_zscore']
factors_df_list = [pd.read_hdf('./factor/%s.h5' % fn) for fn in factor_fn_list]
factors_df = factors_df_list[0].merge(
    factors_df_list[1], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[2], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[3], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[4], on=['data_date', 'secucode'], how='inner')


factors_df = factors_df_list[0].merge(
    factors_df_list[1], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[2], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[3], on=['data_date', 'secucode'], how='inner').merge(
    factors_df_list[4], on=['data_date', 'secucode'], how='inner')
# .merge(
#     factors_df_list[5], on=['data_date', 'secucode'], how='inner')


factors_df.columns = ['data_date', 'secucode','inc_net_profit_year_on_year',  'btop', 'roe', 'size','net_profit_margin']#'var60',


factors_df.to_hdf('./factor/factors_df.h5', key='data')


factors_df.head()


factors_df['equal_weight_alpha'] = factors_df[['inc_net_profit_year_on_year','btop','roe','size',
                                               'net_profit_margin']].mean(axis=1) #'var60',


factors_df[['data_date', 'secucode', 'equal_weight_alpha']]


factors_df[['data_date', 'secucode', 'equal_weight_alpha']].to_hdf('./factor/eaqul_weight_alpha.h5', key='data')


ic_fn_list = ['roe', 'size', 'inc_net_profit_year_on_year', 'btop', 'net_profit_margin']
IC_df = pd.DataFrame([pd.read_hdf('./ic/%s_ic.h5' % name) for name in ic_fn_list], index=ic_fn_list).T


IC_df


IC_120_weight = IC_df.rolling(120).mean().dropna()
ICIR_120_weight = IC_df.rolling(120).apply(lambda x: x.mean()/x.std()).dropna()


IC_120_weight


IC_120_weight.to_csv('ic120.csv')
ICIR_120_weight.to_csv('icir120.csv')


IC_120_weight.plot(figsize=(18,9))


ICIR_120_weight.plot(figsize=(18, 9))


ICIR_120_weight.head()


ICIR_120_weight.columns = [item + '_ic' for item in ICIR_120_weight.columns]


ICIR_120_weight['data_date'] = ICIR_120_weight.index


comobine_df = factors_df.merge(ICIR_120_weight, on=['data_date'], how='left')


comobine_df.dropna(inplace=True)


comobine_df['icir_weighted_alpha'] = comobine_df['inc_net_profit_year_on_year'] * comobine_df['inc_net_profit_year_on_year_ic'] + \
comobine_df['btop'] * comobine_df['btop_ic'] + \
comobine_df['net_profit_margin'] * comobine_df['net_profit_margin_ic'] + \
comobine_df['roe'] * comobine_df['roe_ic'] + \
comobine_df['size'] * comobine_df['size_ic'] 



comobine_df[['data_date', 'secucode', 'icir_weighted_alpha']].to_hdf('icir_weighted_alpha.h5', key='data')


